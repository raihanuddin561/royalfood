generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_NEW")
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  password        String
  name            String
  role            UserRole       @default(EMPLOYEE)
  phone           String?
  address         String?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  partnerId       String?
  employeeProfile Employee?
  inventoryLogs   InventoryLog[]
  createdOrders   Order[]
  createdSales    Sale[]
  securityLogs    SecurityLog[]
  stockUsage      StockUsage[]
  partner         Partner?       @relation(fields: [partnerId], references: [id])

  @@map("users")
}

model Customer {
  id                String            @id @default(cuid())
  email             String            @unique
  phone             String            @unique
  name              String
  password          String
  address           String
  city              String?
  zipCode           String?
  dateOfBirth       DateTime?
  preferences       String?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deliveryAddresses DeliveryAddress[]
  orders            Order[]
  sales             Sale[]

  @@map("customers")
}

model DeliveryAddress {
  id         String   @id @default(cuid())
  customerId String
  label      String
  address    String
  city       String?
  zipCode    String?
  landmark   String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id])
  orders     Order[]

  @@map("delivery_addresses")
}

model Partner {
  id           String        @id @default(cuid())
  name         String
  sharePercent Float
  email        String        @unique
  phone        String?
  address      String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profitShares ProfitShare[]
  users        User[]

  @@map("partners")
}

model ProfitShare {
  id        String   @id @default(cuid())
  partnerId String
  period    DateTime
  revenue   Float
  expenses  Float
  profit    Float
  share     Float
  createdAt DateTime @default(now())
  partner   Partner  @relation(fields: [partnerId], references: [id])

  @@map("profit_shares")
}

model Employee {
  id                  String       @id @default(cuid())
  userId              String       @unique
  employeeId          String       @unique
  position            String
  department          String
  salary              Float
  payMode             PayMode      @default(DAILY)
  standardHoursPerDay Int          @default(8)
  hourlyRate          Float?
  hireDate            DateTime
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  attendance          Attendance[]
  user                User         @relation(fields: [userId], references: [id])
  expenses            Expense[]
  payrolls            Payroll[]

  @@map("employees")
}

model Attendance {
  id            String    @id @default(cuid())
  employeeId    String
  date          DateTime
  checkIn       DateTime?
  checkOut      DateTime?
  totalHours    Float?
  overtimeHours Float?
  createdAt     DateTime  @default(now())
  employee      Employee  @relation(fields: [employeeId], references: [id])

  @@map("attendance")
}

model Payroll {
  id          String        @id @default(cuid())
  employeeId  String
  period      DateTime
  basicSalary Float
  overtime    Float         @default(0)
  bonuses     Float         @default(0)
  deductions  Float         @default(0)
  totalAmount Float
  status      PayrollStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  expenses    Expense[]
  employee    Employee      @relation(fields: [employeeId], references: [id])

  @@map("payrolls")
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       Item[]
  menuItems   MenuItem[]

  @@map("categories")
}

model Supplier {
  id          String     @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       Item[]
  purchases   Purchase[]

  @@map("suppliers")
}

model Item {
  id            String         @id @default(cuid())
  name          String
  categoryId    String
  supplierId    String?
  sku           String         @unique
  description   String?
  specification String?
  brand         String?
  grade         String?
  expiryDate    DateTime?
  receivedDate  DateTime?
  unit          String
  packSize      String?
  costPrice     Float
  sellingPrice  Float?
  reorderLevel  Float
  currentStock  Float          @default(0)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  inventoryLogs InventoryLog[]
  category      Category       @relation(fields: [categoryId], references: [id])
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  orderItems    OrderItem[]
  purchaseItems PurchaseItem[]
  recipeItems   RecipeItem[]
  stockUsage    StockUsage[]

  @@map("items")
}

model InventoryLog {
  id            String           @id @default(cuid())
  itemId        String
  userId        String
  type          InventoryLogType
  quantity      Float
  previousStock Float
  newStock      Float
  reason        String?
  reference     String?
  createdAt     DateTime         @default(now())
  item          Item             @relation(fields: [itemId], references: [id])
  user          User             @relation(fields: [userId], references: [id])

  @@map("inventory_logs")
}

model StockUsage {
  id          String    @id @default(cuid())
  itemId      String
  menuItemId  String?
  orderId     String?
  quantity    Float
  unit        String
  costPerUnit Float
  totalCost   Float
  usageDate   DateTime  @default(now())
  reason      String    @default("PRODUCTION")
  userId      String
  createdAt   DateTime  @default(now())
  item        Item      @relation(fields: [itemId], references: [id])
  menuItem    MenuItem? @relation(fields: [menuItemId], references: [id])
  order       Order?    @relation(fields: [orderId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@map("stock_usage")
}

model MenuItemSale {
  id           String   @id @default(cuid())
  menuItemId   String
  saleId       String
  quantity     Int
  unitPrice    Float
  totalPrice   Float
  unitCost     Float
  totalCost    Float
  grossProfit  Float
  profitMargin Float
  saleDate     DateTime
  createdAt    DateTime @default(now())
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id])
  sale         Sale     @relation(fields: [saleId], references: [id])

  @@map("menu_item_sales")
}

model Purchase {
  id             String         @id @default(cuid())
  supplierId     String?
  purchaseNumber String         @unique
  purchaseDate   DateTime
  totalAmount    Float
  status         PurchaseStatus @default(PENDING)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  expenses       Expense[]
  purchaseItems  PurchaseItem[]
  supplier       Supplier?      @relation(fields: [supplierId], references: [id])

  @@map("purchases")
}

model PurchaseItem {
  id               String    @id @default(cuid())
  purchaseId       String
  itemId           String
  quantity         Float
  receivedQuantity Float     @default(0)
  lastReceivedAt   DateTime?
  unitPrice        Float
  totalPrice       Float
  createdAt        DateTime  @default(now())
  item             Item      @relation(fields: [itemId], references: [id])
  purchase         Purchase  @relation(fields: [purchaseId], references: [id])

  @@map("purchase_items")
}

model MenuItem {
  id             String         @id @default(cuid())
  name           String
  categoryId     String
  description    String?
  price          Float
  costPrice      Float          @default(0)
  deliveryCharge Float          @default(0)
  isAvailable    Boolean        @default(true)
  isActive       Boolean        @default(true)
  image          String?
  prepTime       Int?
  servingSize    Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  menuItemSales  MenuItemSale[]
  category       Category       @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  recipeItems    RecipeItem[]
  stockUsage     StockUsage[]

  @@map("menu_items")
}

model RecipeItem {
  id         String   @id @default(cuid())
  menuItemId String
  itemId     String
  quantity   Float
  unit       String
  cost       Float    @default(0)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  item       Item     @relation(fields: [itemId], references: [id])
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@map("recipe_items")
}

model Order {
  id                String           @id @default(cuid())
  orderNumber       String           @unique
  customerId        String?
  deliveryAddressId String?
  userId            String?
  guestName         String?
  guestPhone        String?
  guestEmail        String?
  guestAddress      String?
  orderType         OrderType
  status            OrderStatus      @default(PENDING)
  tableNumber       String?
  isPreOrder        Boolean          @default(false)
  scheduledDate     DateTime?
  scheduledTime     String?
  subtotal          Float            @default(0)
  taxAmount         Float            @default(0)
  discountAmount    Float            @default(0)
  deliveryFee       Float            @default(0)
  totalAmount       Float            @default(0)
  finalAmount       Float            @default(0)
  notes             String?
  kitchenNotes      String?
  estimatedTime     Int?
  paymentMethod     PaymentMethod    @default(CASH)
  paymentStatus     PaymentStatus    @default(PENDING)
  orderDate         DateTime         @default(now())
  confirmedAt       DateTime?
  preparingAt       DateTime?
  readyAt           DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  orderItems        OrderItem[]
  orderTracking     OrderTracking[]
  customer          Customer?        @relation(fields: [customerId], references: [id])
  deliveryAddress   DeliveryAddress? @relation(fields: [deliveryAddressId], references: [id])
  user              User?            @relation(fields: [userId], references: [id])
  sale              Sale?
  stockUsage        StockUsage[]

  @@map("orders")
}

model OrderItem {
  id         String    @id @default(cuid())
  orderId    String
  menuItemId String?
  itemId     String?
  quantity   Float
  unitPrice  Float
  totalPrice Float
  notes      String?
  createdAt  DateTime  @default(now())
  item       Item?     @relation(fields: [itemId], references: [id])
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id])
  order      Order     @relation(fields: [orderId], references: [id])

  @@map("order_items")
}

model OrderTracking {
  id            String      @id @default(cuid())
  orderId       String
  status        OrderStatus
  message       String?
  updatedBy     String?
  timestamp     DateTime    @default(now())
  estimatedTime Int?
  order         Order       @relation(fields: [orderId], references: [id])

  @@map("order_tracking")
}

model Sale {
  id             String         @id @default(cuid())
  orderId        String?        @unique
  saleNumber     String         @unique
  userId         String
  customerId     String?
  saleDate       DateTime
  subtotal       Float          @default(0)
  taxAmount      Float          @default(0)
  discountAmount Float          @default(0)
  deliveryFee    Float          @default(0)
  totalAmount    Float          @default(0)
  finalAmount    Float          @default(0)
  paymentMethod  PaymentMethod
  status         SaleStatus     @default(COMPLETED)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  menuItemSales  MenuItemSale[]
  customer       Customer?      @relation(fields: [customerId], references: [id])
  order          Order?         @relation(fields: [orderId], references: [id])
  user           User           @relation(fields: [userId], references: [id])

  @@map("sales")
}

model ExpenseCategory {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  type        ExpenseType @default(OPERATIONAL)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  expenses    Expense[]

  @@map("expense_categories")
}

model Expense {
  id                String           @id @default(cuid())
  expenseCategoryId String
  description       String
  amount            Float
  expenseDate       DateTime
  receiptImage      String?
  supplierInfo      String?
  payrollId         String?
  employeeId        String?
  purchaseId        String?
  taxAmount         Float            @default(0)
  isRecurring       Boolean          @default(false)
  recurringPeriod   RecurringPeriod?
  nextDueDate       DateTime?
  notes             String?
  status            ExpenseStatus    @default(APPROVED)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  employee          Employee?        @relation(fields: [employeeId], references: [id])
  expenseCategory   ExpenseCategory  @relation(fields: [expenseCategoryId], references: [id])
  payroll           Payroll?         @relation(fields: [payrollId], references: [id])
  purchase          Purchase?        @relation(fields: [purchaseId], references: [id])

  @@map("expenses")
}

model FinancialReport {
  id                  String     @id @default(cuid())
  reportType          ReportType
  periodStart         DateTime
  periodEnd           DateTime
  totalRevenue        Float
  totalExpenses       Float
  totalProfit         Float
  stockExpenses       Float
  payrollExpenses     Float
  operationalExpenses Float
  taxExpenses         Float
  partnerShare1       Float
  partnerShare2       Float
  reportData          Json
  generatedAt         DateTime   @default(now())

  @@map("financial_reports")
}

model SecurityLog {
  id          String   @id @default(cuid())
  userId      String?
  eventType   String
  description String
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])

  @@map("security_logs")
}

model DeliverySettings {
  id                    String   @id @default(cuid())
  globalDeliveryCharge  Float    @default(0)
  freeDeliveryThreshold Float    @default(0)
  isGlobalChargeActive  Boolean  @default(false)
  maxDeliveryDistance   Float    @default(10)
  deliveryTimeSlots     Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("delivery_settings")
}

model TaxSettings {
  id             String   @id @default(cuid())
  taxRate        Float    @default(0)
  isTaxActive    Boolean  @default(false)
  taxLabel       String   @default("Tax")
  includeInPrice Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("tax_settings")
}

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
  CUSTOMER
}

enum PayMode {
  DAILY
  HOURLY
}

enum PayrollStatus {
  PENDING
  APPROVED
  PAID
}

enum InventoryLogType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  WASTE
  TRANSFER
}

enum PurchaseStatus {
  PENDING
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  SERVED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  DIGITAL_WALLET
  BANK_TRANSFER
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  CANCELLED
}

enum ExpenseType {
  OPERATIONAL
  STOCK
  PAYROLL
  UTILITIES
  RENT
  MARKETING
  MAINTENANCE
  INSURANCE
  TAXES
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum RecurringPeriod {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ReportType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}
